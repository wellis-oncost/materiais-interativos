diff -urN a/js/ai-connector.js b/js/ai-connector.js
--- a/js/ai-connector.js	2026-09-25 12:02:30.657573685 +0000
+++ b/js/ai-connector.js	2026-09-25 12:02:30.658430944 +0000
@@ -33,14 +33,14 @@
   const controller=new AbortController(); const timer=setTimeout(()=>controller.abort(),Math.max(5000,Number(timeoutMs)||90000));
   const headers={'Content-Type':'application/json','Accept':'application/json'};
   if(String(apiKey||'').trim())headers.Authorization=`Bearer ${String(apiKey).trim()}`;
-  const body={model:modelName,messages:[{role:'system',content:'Gere questões educacionais e devolva somente JSON válido conforme solicitado.'},{role:'user',content:String(prompt||'')}],temperature:0.5};
+  const body={model:modelName,messages:[{role:'system',content:'Gere questões educacionais seguindo exatamente o formato solicitado pelo usuário. Não acrescente introdução ou despedida.'},{role:'user',content:String(prompt||'')}],temperature:0.5};
   try{
     const response=await fetchImpl(url,{method:'POST',headers,body:JSON.stringify(body),signal:controller.signal,referrerPolicy:'no-referrer'});
     let payload=null; const raw=await response.text();
     try{payload=raw?JSON.parse(raw):null;}catch{payload=raw;}
     if(!response.ok){const message=typeof payload==='object'&&(payload?.error?.message||payload?.message);throw new Error(message||`O endpoint respondeu com HTTP ${response.status}.`);}
     const content=extractAssistantText(payload);
-    if(!content)throw new Error('O endpoint respondeu, mas não foi encontrado texto com o JSON das questões.');
+    if(!content)throw new Error('O endpoint respondeu, mas não foi encontrado texto com as questões.');
     return {content,payload};
   }catch(err){
     if(err?.name==='AbortError')throw new Error('A geração excedeu o tempo limite configurado.');
