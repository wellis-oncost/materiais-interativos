+async function getImageDimensions(file){
+  if(typeof createImageBitmap==='function'){
+    try{
+      const bitmap=await createImageBitmap(file,{imageOrientation:'from-image'});
+      const out={width:bitmap.width||null,height:bitmap.height||null};
+      bitmap.close?.();
+      return out;
+    }catch{}
+  }
+  return new Promise(resolve=>{
+    const url=URL.createObjectURL(file);
+    const img=new Image();
+    img.onload=()=>{const out={width:img.naturalWidth||null,height:img.naturalHeight||null};URL.revokeObjectURL(url);resolve(out);};
+    img.onerror=()=>{URL.revokeObjectURL(url);resolve({width:null,height:null});};
+    img.src=url;
+  });
+}
+
+export async function extractImage(file,onProgress=()=>{},options={}){
+  const language=normalizeOcrLanguage(options.ocrLanguage||'por');
+  let worker=null;
+  try{
+    onProgress({label:'Preparando OCR da imagem…',ocr:true});
+    const dimensions=await getImageDimensions(file);
+    worker=await createOcrWorker(language,onProgress);
+    onProgress({current:1,total:1,label:'Lendo imagem com OCR…',ocr:true});
+    const result=await worker.recognize(file,{rotateAuto:true});
+    const text=String(result?.data?.text||'').trim();
+    if(!text) throw new Error('O OCR não encontrou texto legível nesta imagem. Tente uma foto mais nítida ou use PDF/DOCX/TXT.');
+    const lines=plainTextToOcrLines(text,1,dimensions.width,dimensions.height);
+    if(!lines.length) throw new Error('O OCR não encontrou linhas de texto utilizáveis nesta imagem.');
+    const textChars=lines.reduce((n,x)=>n+(x.text?.length||0),0);
+    const lineCount=lines.filter(x=>x.text?.trim()).length;
+    return {
+      text:lines.map(x=>x.text).join('\n'),
+      meta:{
+        kind:'image',filename:file.name,pageCount:1,
+        pageDimensions:[{page:1,width:dimensions.width,height:dimensions.height}],
+        lineMap:lines.map(x=>({page:1,pageWidth:dimensions.width,pageHeight:dimensions.height,ocr:true,blank:Boolean(x.blank)})),
+        pageStats:[{page:1,textChars,lineCount,width:dimensions.width,height:dimensions.height,layout:null}],
+        layout:{analyzedPages:1,twoColumnPages:[],tableRows:0,twoColumnTablePages:[],visualPages:[1],formulaPages:[],imagePages:[1],visualCandidateCount:0},
+        visualCandidates:[],
+        ocr:{requestedMode:'image',language,engine:'tesseract.js',engineVersion:'7.0.0',pages:[1],summary:{pageCount:1,nativePages:0,ocrPages:1,emptyNativePages:1}},
+        warnings:['Imagem processada com OCR. Confira a transcrição antes de iniciar a atividade.']
+      }
+    };
+  }finally{
+    if(worker) try{await worker.terminate();}catch{}
+  }
+}
